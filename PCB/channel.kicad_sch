	(text "gain is Rsense*(1+9.9k/Rg) = 100*(1+9.9k/0.36k) = 2.85 mV/uA\nVoltage output range is thus +/-3333*0.00285 = +/-9.5V\noutput needs to be within +/-10V\ncurrent sensing resolution is 10000 mV / 2^12 / (2.85mV/uA) = 0.86uA"
		(exclude_from_sim no)
		(at 108.204 30.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "387e020b-aed1-4758-999e-61bc7336da80")
	)
	(text "OE0    OE1       Output      \n\n0       0         VOLTAGE     \n1       0         CURRENT    \n0       1         High-Z  \n1       1         GND  "
